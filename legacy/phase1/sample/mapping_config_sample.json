{
  "_comment": "Sample: group rules are checked in order; first match wins.",
  "group_rules": [
    {"group_pattern": "^CORP\\\\APP-(.+)-Owners$", "safe": "APP-{1}", "min_permission": "Owner"},
    {"group": "CORP\\DBA-Team", "safe": "DB-Production-Privileged-Accounts"},
    {"group": "CORP\\Web-Ops", "safe": "WEB-Ops"},
    {"group": "CORP\\Unix-Admins", "safe": "UNIX-Admins", "min_permission": "Owner"},
    {"group": "CORP\\Finance-Admins", "safe": "FIN-Vendors"}
  ],
  "folder_rules": [
    {"folder_prefix": "\\IT\\Network", "safe": "NET-Devices"}
  ],
  "fallback_strategy": "folder_path"
}
